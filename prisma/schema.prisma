generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model University {
  id               String              @id @default(cuid())
  name             String
  logo             String?
  address          String?
  createdAt        DateTime            @default(now())
  faculties        Faculty[]
  profiles         Profile[]
  semesters        Semester[]
  logs             ActivityLog[]
  settings         UniversitySettings?
  supportTickets   SupportTicket[]
  students         Student[]
  rooms            Room[]
  blackouts        AcademicBlackout[]
  facilitiesIssues FacilitiesIssue[]
}

model UniversitySettings {
  id                          String     @id @default(cuid())
  universityId                String     @unique
  university                  University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  latePingThresholdMinutes    Int        @default(30)
  submissionWindowHours       Int        @default(2)
  flagCoverageWeek6           Int        @default(60)
  flagCoverageWeek10          Int        @default(80)
  flagRepeatThreshold         Int        @default(3)
  lecturerAbsenceSmsEnabled   Boolean    @default(true)
  lecturerAbsenceEmailEnabled Boolean    @default(true)
  latePingSmsEnabled          Boolean    @default(true)
  latePingEmailEnabled        Boolean    @default(true)
  qaLatePingEmailEnabled      Boolean    @default(true)
  showUpAiEnabled             Boolean    @default(true)
  contestSlaDays              Int        @default(5)
  notificationMaxRetries      Int        @default(3)
  lecturerDigestEnabled       Boolean    @default(false)
  studentAttendanceThreshold  Int        @default(75)
  lateGraceMinutes            Int        @default(10)
  backupEscalateMinutes       Int        @default(30)
  lateSubmissionHours         Int        @default(24)
  missedReportFlagThreshold   Int        @default(3)
  backupNotifySmsEnabled      Boolean    @default(true)
  repReminderSmsEnabled       Boolean    @default(true)
  attendanceEditWindowHours   Int        @default(24)
  setupWizardCompletedAt      DateTime?
  updatedById                 String?
  updatedAt                   DateTime   @updatedAt
}

model Faculty {
  id           String       @id @default(cuid())
  name         String
  universityId String
  university   University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  departments  Department[]
}

model Department {
  id        String             @id @default(cuid())
  name      String
  facultyId String
  faculty   Faculty            @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  courses   Course[]
  profiles  Profile[]
  lecturers Lecturer[]
  blackouts AcademicBlackout[]
}

model Semester {
  id           String     @id @default(cuid())
  name         String
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean    @default(false)
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  courses      Course[]
  createdAt    DateTime   @default(now())
}

model Profile {
  id                       String              @id @default(cuid())
  supabaseUid              String              @unique
  anonymousAlias           String?             @unique
  displayName              String?
  email                    String?
  phone                    String?
  role                     Role
  departmentId             String?
  department               Department?         @relation(fields: [departmentId], references: [id])
  universityId             String
  university               University          @relation(fields: [universityId], references: [id], onDelete: Cascade)
  repAssignments           RepAssignment[]
  submissions              LectureReport[]
  contestsRaised           Contest[]           @relation("ContestRaisedBy")
  contestsResolved         Contest[]           @relation("ContestResolvedBy")
  latePingsSent            LatePing[]
  identityLookups          IdentityLookup[]    @relation("LookedUpProfile")
  lookupsMade              IdentityLookup[]    @relation("LookupPerformer")
  uploadedOutlines         CourseOutline[]
  activityLogs             ActivityLog[]
  supportTicketsRequested  SupportTicket[]     @relation("SupportRequester")
  supportTicketsAssigned   SupportTicket[]     @relation("SupportAssignee")
  rosterProposalsMade      RosterProposal[]    @relation("RosterProposedBy")
  rosterProposalsReviewed  RosterProposal[]    @relation("RosterReviewedBy")
  flagEvents               FlagEvent[]
  lecturerId               String?             @unique
  lecturer                 Lecturer?           @relation(fields: [lecturerId], references: [id], onDelete: SetNull)
  attendanceSessionsOpened AttendanceSession[] @relation("AttendanceOpenedBy")
  attendanceRecordsMarked  AttendanceRecord[]  @relation("AttendanceMarkedBy")
  attendanceRecordEdits    AttendanceRecordEdit[] @relation("AttendanceEditedBy")
  facilitiesIssuesReported FacilitiesIssue[]   @relation("FacilitiesReportedBy")
  lectureSessionsUpdated   LectureSession[]    @relation("SessionUpdatedBy")
  sessionConfirmations     SessionConfirmation[] @relation("SessionConfirmedBy")
  repNotifications         RepNotification[]
  repReliabilityFlags      RepReliabilityFlag[]
  discrepanciesResolved    ReportDiscrepancy[]  @relation("DiscrepancyResolvedBy")
  isActive                 Boolean             @default(true)
  createdAt                DateTime            @default(now())
}

enum Role {
  SUPER_ADMIN
  VC
  QA_OFFICER
  QA_ASSISTANT
  IT
  HOD
  HOD_ASSISTANT
  LECTURER
  CLASS_REP
}

model SealedRepIdentity {
  id          String          @id @default(cuid())
  realName    String
  realEmail   String
  realPhone   String
  courseId    String
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignments RepAssignment[]
  createdAt   DateTime        @default(now())

  @@unique([courseId, realEmail])
}

enum RosterProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

model RosterProposal {
  id           String               @id @default(cuid())
  courseId     String
  course       Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  realName     String
  realEmail    String
  realPhone    String
  proposedById String
  proposedBy   Profile              @relation("RosterProposedBy", fields: [proposedById], references: [id])
  status       RosterProposalStatus @default(PENDING)
  reviewedById String?
  reviewedBy   Profile?             @relation("RosterReviewedBy", fields: [reviewedById], references: [id])
  reviewNote   String?
  createdAt    DateTime             @default(now())
  reviewedAt   DateTime?

  @@index([courseId, status])
  @@index([status, createdAt])
}

model Lecturer {
  id                 String                 @id @default(cuid())
  firstName          String
  lastName           String
  email              String                 @unique
  phone              String
  staffId            String                 @unique
  departmentId       String
  department         Department             @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  courses            Course[]
  flags              Flag[]
  notifications      LecturerNotification[]
  digestEmailEnabled Boolean                @default(false)
  profile            Profile?
  substituteSessions LectureSession[]       @relation("SessionSubstitute")
  createdAt          DateTime               @default(now())
}

model Course {
  id                     String                  @id @default(cuid())
  code                   String
  title                  String
  departmentId           String
  department             Department              @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  semesterId             String
  semester               Semester                @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  lecturerId             String
  lecturer               Lecturer                @relation(fields: [lecturerId], references: [id])
  outline                CourseOutline?
  schedule               ClassSchedule[]
  reports                LectureReport[]
  latePings              LatePing[]
  repAssignments         RepAssignment[]
  sealedIdentities       SealedRepIdentity[]
  rosterProposals        RosterProposal[]
  discrepancies          ReportDiscrepancy[]
  enrollments            CourseEnrollment[]
  attendanceSessions     AttendanceSession[]
  studentAttendanceFlags StudentAttendanceFlag[]
  classGroups            ClassGroup[]
  lectureSessions        LectureSession[]
  creditHours            Int
  classSize              Int?
  createdAt              DateTime                @default(now())

  @@unique([code, semesterId])
}

model CourseOutline {
  id           String         @id @default(cuid())
  courseId     String         @unique
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  fileUrl      String
  fileName     String
  outlineType  OutlineType
  topics       OutlineTopic[]
  uploadedById String
  uploadedBy   Profile        @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime       @default(now())
}

enum OutlineType {
  WEEKLY
  FLAT
}

model OutlineTopic {
  id          String        @id @default(cuid())
  outlineId   String
  outline     CourseOutline @relation(fields: [outlineId], references: [id], onDelete: Cascade)
  title       String
  description String?
  weekNumber  Int?
  order       Int
  reportedIn  ReportTopic[]
}

model ClassSchedule {
  id                 String              @id @default(cuid())
  courseId           String
  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  dayOfWeek          Int
  startTime          String
  endTime            String
  venue              String?
  roomId             String?
  room               Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  classGroupId       String?
  classGroup         ClassGroup?         @relation(fields: [classGroupId], references: [id], onDelete: SetNull)
  reports            LectureReport[]
  latePings          LatePing[]
  attendanceSessions AttendanceSession[]
  lectureSessions    LectureSession[]

  @@index([roomId])
  @@index([classGroupId])
}

enum RepDutyRole {
  PRIMARY
  BACKUP
}

model RepAssignment {
  id                   String            @id @default(cuid())
  courseId             String
  course               Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  profileId            String
  profile              Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sealedIdentityId     String
  sealedIdentity       SealedRepIdentity @relation(fields: [sealedIdentityId], references: [id])
  startDate            DateTime
  endDate              DateTime?
  isActive             Boolean           @default(true)
  dutyRole             RepDutyRole       @default(PRIMARY)
  rotationOrder        Int
  assignedById         String
  rotationWeeks        Int               @default(4)
  missedReportCount    Int               @default(0)
  lastMissedAt         DateTime?
  reliabilityFlaggedAt DateTime?
  createdAt            DateTime          @default(now())
  logs                 RotationLog[]

  @@index([courseId, isActive])
  @@index([courseId, dutyRole, isActive])
}

model LectureReport {
  id                      String              @id @default(cuid())
  courseId                String
  course                  Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scheduleId              String
  schedule                ClassSchedule       @relation(fields: [scheduleId], references: [id])
  submittedById           String
  submittedBy             Profile             @relation(fields: [submittedById], references: [id])
  lectureDate             DateTime
  lecturerPresent         PresenceStatus
  substituteNote          String?
  arrivalStatus           ArrivalStatus?
  lateMinutes             Int?
  earlyDismissal          Boolean             @default(false)
  dismissedEarlyMinutes   Int?
  topicsCovered           ReportTopic[]
  previousTopicsRevisited Boolean             @default(false)
  teachingAids            TeachingAid[]
  wasInteractive          InteractiveLevel
  studentCount            Int?
  additionalNotes         String?
  isContested             Boolean             @default(false)
  isVoided                Boolean             @default(false)
  contest                 Contest?
  latePing                LatePing?
  flags                   Flag[]
  discrepanciesAsFirst    ReportDiscrepancy[] @relation("DiscrepancyFirst")
  discrepanciesAsSecond   ReportDiscrepancy[] @relation("DiscrepancySecond")
  lectureSessionId        String?
  lectureSession          LectureSession?     @relation(fields: [lectureSessionId], references: [id], onDelete: SetNull)
  isLateSubmission        Boolean             @default(false)
  submissionSource        SubmissionSource    @default(WEB)
  submittedAt             DateTime            @default(now())
  windowClosedAt          DateTime

  @@unique([scheduleId, lectureDate, submittedById])
  @@index([courseId, lectureDate])
  @@index([lectureDate, lecturerPresent])
  @@index([lectureDate, arrivalStatus])
  @@index([submittedById, lectureDate])
  @@index([isLateSubmission, lectureDate])
}

enum SubmissionSource {
  WEB
  OFFLINE_DRAFT
  SMS
}

model LatePing {
  id                  String         @id @default(cuid())
  courseId            String
  course              Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scheduleId          String
  schedule            ClassSchedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  sentById            String
  sentBy              Profile        @relation(fields: [sentById], references: [id], onDelete: Cascade)
  lectureDate         DateTime
  minutesLate         Int
  lecturerSmsStatus   DeliveryStatus
  lecturerEmailStatus DeliveryStatus
  qaNotified          Boolean        @default(true)
  acknowledgeToken    String         @unique
  acknowledgedAt      DateTime?
  hodNotified         Boolean        @default(false)
  hodNotifiedAt       DateTime?
  reportId            String?        @unique
  report              LectureReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  createdAt           DateTime       @default(now())

  @@index([courseId, lectureDate])
  @@index([lectureDate, acknowledgedAt])
}

enum PresenceStatus {
  PRESENT
  ABSENT
  SUBSTITUTE
}

enum ArrivalStatus {
  ON_TIME
  LATE
}

enum InteractiveLevel {
  YES
  SOMEWHAT
  NO
}

model TeachingAid {
  id       String        @id @default(cuid())
  reportId String
  report   LectureReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  type     AidType
}

enum AidType {
  SLIDES
  WHITEBOARD
  HANDOUTS
  VIDEO
  NONE
  OTHER
}

model ReportTopic {
  id       String        @id @default(cuid())
  reportId String
  report   LectureReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  topicId  String
  topic    OutlineTopic  @relation(fields: [topicId], references: [id])

  @@unique([reportId, topicId])
}

model Contest {
  id             String        @id @default(cuid())
  reportId       String        @unique
  report         LectureReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  raisedById     String
  raisedBy       Profile       @relation("ContestRaisedBy", fields: [raisedById], references: [id])
  reason         String
  evidenceUrl    String?
  status         ContestStatus @default(PENDING)
  resolvedById   String?
  resolvedBy     Profile?      @relation("ContestResolvedBy", fields: [resolvedById], references: [id])
  resolutionNote String?
  raisedAt       DateTime      @default(now())
  resolvedAt     DateTime?
  escalatedAt    DateTime?

  @@index([status, raisedAt])
}

enum ContestStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

model Flag {
  id                     String         @id @default(cuid())
  lecturerId             String
  lecturer               Lecturer       @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  reportId               String?
  report                 LectureReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  type                   FlagType
  message                String
  internalNotes          String?
  isResolved             Boolean        @default(false)
  notificationSent       Boolean        @default(false)
  attributedToFacilities Boolean        @default(false)
  createdAt              DateTime       @default(now())
  events                 FlagEvent[]

  @@index([isResolved, createdAt])
  @@index([lecturerId, createdAt])
}

enum FlagEventType {
  CREATED
  RESOLVED
  REOPENED
  ACKNOWLEDGED
  RESPONDED
}

model FlagEvent {
  id        String        @id @default(cuid())
  flagId    String
  flag      Flag          @relation(fields: [flagId], references: [id], onDelete: Cascade)
  type      FlagEventType
  actorId   String?
  actor     Profile?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  note      String?
  createdAt DateTime      @default(now())

  @@index([flagId, createdAt])
}

enum FlagType {
  ABSENCE
  LATENESS
  EARLY_DISMISSAL
  COVERAGE_LAG
  REPEATED_ABSENCE
  REPEATED_LATENESS
}

model LecturerNotification {
  id            String              @id @default(cuid())
  lecturerId    String
  lecturer      Lecturer            @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  channel       NotificationChannel
  message       String
  subject       String?
  sentAt        DateTime            @default(now())
  status        DeliveryStatus
  attemptCount  Int                 @default(1)
  lastAttemptAt DateTime            @default(now())
  nextRetryAt   DateTime?

  @@index([status, nextRetryAt])
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum DeliveryStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

model IdentityLookup {
  id                String   @id @default(cuid())
  performedById     String
  performedBy       Profile  @relation("LookupPerformer", fields: [performedById], references: [id])
  lookedUpProfileId String
  lookedUpProfile   Profile  @relation("LookedUpProfile", fields: [lookedUpProfileId], references: [id])
  reason            String
  performedAt       DateTime @default(now())
}

model RotationLog {
  id            String         @id @default(cuid())
  courseId      String
  assignmentId  String?
  assignment    RepAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  outgoingAlias String?
  incomingAlias String?
  action        String
  error         String?
  createdAt     DateTime       @default(now())
}

enum ReportDiscrepancyStatus {
  OPEN
  RESOLVED
}

enum DiscrepancyKind {
  PEER_REPORT
  LECTURER_CONFIRMATION
}

model ReportDiscrepancy {
  id               String                  @id @default(cuid())
  courseId         String
  course           Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scheduleId       String
  lectureDate      DateTime
  kind             DiscrepancyKind         @default(PEER_REPORT)
  firstReportId    String
  firstReport      LectureReport           @relation("DiscrepancyFirst", fields: [firstReportId], references: [id], onDelete: Cascade)
  secondReportId   String?
  secondReport     LectureReport?          @relation("DiscrepancySecond", fields: [secondReportId], references: [id], onDelete: Cascade)
  confirmationId   String?                 @unique
  confirmation     SessionConfirmation?    @relation(fields: [confirmationId], references: [id], onDelete: SetNull)
  status           ReportDiscrepancyStatus @default(OPEN)
  resolvedById     String?
  resolvedBy       Profile?                @relation("DiscrepancyResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote   String?
  resolvedAt       DateTime?
  createdAt        DateTime                @default(now())

  @@unique([scheduleId, lectureDate])
  @@index([status, createdAt])
  @@index([kind, status])
}

model ActivityLog {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  actorId      String?
  actor        Profile?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action       String
  metadata     Json?
  createdAt    DateTime   @default(now())
}

model LeadInquiry {
  id          String     @id @default(cuid())
  fullName    String
  email       String
  institution String
  role        String
  message     String?
  clientIp    String?
  status      LeadStatus @default(NEW)
  createdAt   DateTime   @default(now())

  @@index([clientIp, createdAt])
  @@index([email, createdAt])
}

model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

model Student {
  id            String                  @id @default(cuid())
  universityId  String
  university    University              @relation(fields: [universityId], references: [id], onDelete: Cascade)
  studentNumber String
  fullName      String
  email         String?
  enrollments   CourseEnrollment[]
  records       AttendanceRecord[]
  flags         StudentAttendanceFlag[]
  createdAt     DateTime                @default(now())

  @@unique([universityId, studentNumber])
  @@index([universityId, fullName])
}

model CourseEnrollment {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([courseId, studentId])
  @@index([studentId])
}

enum AttendanceSessionStatus {
  OPEN
  CLOSED
}

enum StudentAttendanceMark {
  PRESENT
  ABSENT
  LATE
}

model AttendanceSession {
  id          String                  @id @default(cuid())
  courseId    String
  course      Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scheduleId  String?
  schedule    ClassSchedule?          @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  lectureDate DateTime
  status      AttendanceSessionStatus @default(OPEN)
  openedById  String
  openedBy    Profile                 @relation("AttendanceOpenedBy", fields: [openedById], references: [id])
  closedAt    DateTime?
  createdAt   DateTime                @default(now())
  records     AttendanceRecord[]

  @@index([courseId, lectureDate])
  @@index([status, createdAt])
}

model AttendanceRecord {
  id         String                 @id @default(cuid())
  sessionId  String
  session    AttendanceSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     StudentAttendanceMark
  markedById String
  markedBy   Profile                @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  edits      AttendanceRecordEdit[]
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId, status])
}

model AttendanceRecordEdit {
  id         String                 @id @default(cuid())
  recordId   String
  record     AttendanceRecord       @relation(fields: [recordId], references: [id], onDelete: Cascade)
  fromStatus StudentAttendanceMark?
  toStatus   StudentAttendanceMark
  editedById String
  editedBy   Profile                @relation("AttendanceEditedBy", fields: [editedById], references: [id], onDelete: Cascade)
  note       String?
  createdAt  DateTime               @default(now())

  @@index([recordId, createdAt])
  @@index([editedById, createdAt])
}

enum StudentAttendanceFlagStatus {
  OPEN
  RESOLVED
}

model StudentAttendanceFlag {
  id                String                      @id @default(cuid())
  studentId         String
  student           Student                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course                      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attendancePercent Int
  threshold         Int
  status            StudentAttendanceFlagStatus @default(OPEN)
  createdAt         DateTime                    @default(now())
  resolvedAt        DateTime?

  @@unique([studentId, courseId])
  @@index([courseId, status])
}

enum LeadStatus {
  NEW
  CONTACTED
  DEMO_SCHEDULED
  CLOSED
}

model SupportTicket {
  id             String                @id @default(cuid())
  universityId   String
  university     University            @relation(fields: [universityId], references: [id], onDelete: Cascade)
  requesterId    String
  requester      Profile               @relation("SupportRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignedToId   String?
  assignedTo     Profile?              @relation("SupportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  subject        String
  message        String
  category       SupportTicketCategory
  priority       SupportPriority       @default(NORMAL)
  status         SupportTicketStatus   @default(OPEN)
  resolutionNote String?
  emailStatus    DeliveryStatus        @default(SKIPPED)
  smsStatus      DeliveryStatus        @default(SKIPPED)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  resolvedAt     DateTime?
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketCategory {
  LOGIN_ACCESS
  COURSE_SETUP
  REPORTING_ISSUE
  NOTIFICATION_ISSUE
  DATA_CORRECTION
  OTHER
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum LectureSessionStatus {
  SCHEDULED
  ON_TIME
  DELAYED
  ROOM_CHANGED
  RESCHEDULED
  CANCELLED_WITH_NOTICE
  CANCELLED_NO_NOTICE
  MAKE_UP
}

enum SessionDisruptionReason {
  ROOM_NOT_READY
  POWER_PROJECTOR
  LECTURER_EMERGENCY
  UNIVERSITY_EVENT
  OTHER
}

enum BlackoutType {
  HOLIDAY
  EXAM_WEEK
  STRIKE
  CLOSURE
  OTHER
}

enum FacilitiesIssueStatus {
  OPEN
  RESOLVED
}

model Room {
  id               String            @id @default(cuid())
  universityId     String
  university       University        @relation(fields: [universityId], references: [id], onDelete: Cascade)
  code             String
  name             String
  building         String?
  capacity         Int?
  isActive         Boolean           @default(true)
  schedules        ClassSchedule[]
  sessions         LectureSession[]
  facilitiesIssues FacilitiesIssue[]
  createdAt        DateTime          @default(now())

  @@unique([universityId, code])
  @@index([universityId, isActive])
}

model ClassGroup {
  id           String                @id @default(cuid())
  courseId     String
  course       Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  code         String
  name         String
  schedules    ClassSchedule[]
  sessionLinks LectureSessionGroup[]
  createdAt    DateTime              @default(now())

  @@unique([courseId, code])
}

enum SessionReportCoverage {
  PENDING
  REPORTED
  LATE_REPORTED
  NO_DATA
}

model LectureSession {
  id                     String                   @id @default(cuid())
  courseId               String
  course                 Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scheduleId             String
  schedule               ClassSchedule            @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  lectureDate            DateTime
  status                 LectureSessionStatus     @default(SCHEDULED)
  reason                 SessionDisruptionReason?
  reasonNote             String?
  attributedToFacilities Boolean                  @default(false)
  reportCoverage         SessionReportCoverage    @default(PENDING)
  primaryNotifiedAt      DateTime?
  backupNotifiedAt       DateTime?
  noDataMarkedAt         DateTime?
  roomId                 String?
  room                   Room?                    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  substituteLecturerId   String?
  substituteLecturer     Lecturer?                @relation("SessionSubstitute", fields: [substituteLecturerId], references: [id], onDelete: SetNull)
  makeupOfSessionId      String?
  makeupOfSession        LectureSession?          @relation("SessionMakeup", fields: [makeupOfSessionId], references: [id], onDelete: SetNull)
  makeups                LectureSession[]         @relation("SessionMakeup")
  updatedById            String?
  updatedBy              Profile?                 @relation("SessionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  classGroups            LectureSessionGroup[]
  reports                LectureReport[]
  facilitiesIssues       FacilitiesIssue[]
  confirmation           SessionConfirmation?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@unique([scheduleId, lectureDate])
  @@index([courseId, lectureDate])
  @@index([status, lectureDate])
  @@index([attributedToFacilities, lectureDate])
  @@index([roomId, lectureDate])
  @@index([reportCoverage, lectureDate])
}

model SessionConfirmation {
  id               String              @id @default(cuid())
  lectureSessionId String              @unique
  lectureSession   LectureSession      @relation(fields: [lectureSessionId], references: [id], onDelete: Cascade)
  confirmedById    String
  confirmedBy      Profile             @relation("SessionConfirmedBy", fields: [confirmedById], references: [id], onDelete: Cascade)
  presence         PresenceStatus
  note             String?
  confirmedAt      DateTime            @default(now())
  discrepancy      ReportDiscrepancy?

  @@index([confirmedById, confirmedAt])
}

model RepNotification {
  id            String              @id @default(cuid())
  profileId     String
  profile       Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  courseId      String?
  sessionId     String?
  channel       NotificationChannel
  kind          RepNotificationKind
  message       String
  subject       String?
  sentAt        DateTime            @default(now())
  status        DeliveryStatus
  attemptCount  Int                 @default(1)
  lastAttemptAt DateTime            @default(now())
  nextRetryAt   DateTime?

  @@index([status, nextRetryAt])
  @@index([profileId, sentAt])
  @@index([sessionId, kind])
}

enum RepNotificationKind {
  BACKUP_ESCALATION
  PRIMARY_REMINDER
  MISSING_REPORT_NUDGE
  SMS_REPORT_HINT
}

model RepReliabilityFlag {
  id         String                  @id @default(cuid())
  profileId  String
  profile    Profile                 @relation(fields: [profileId], references: [id], onDelete: Cascade)
  courseId   String?
  type       RepReliabilityFlagType
  message    String
  isResolved Boolean                 @default(false)
  createdAt  DateTime                @default(now())
  resolvedAt DateTime?

  @@index([profileId, isResolved, createdAt])
  @@index([isResolved, createdAt])
}

enum RepReliabilityFlagType {
  REPEATED_MISS_REPORT
}

model LectureSessionGroup {
  id           String         @id @default(cuid())
  sessionId    String
  session      LectureSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  classGroupId String
  classGroup   ClassGroup     @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  @@unique([sessionId, classGroupId])
  @@index([classGroupId])
}

model AcademicBlackout {
  id              String       @id @default(cuid())
  universityId    String
  university      University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  departmentId    String?
  department      Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  type            BlackoutType
  title           String
  startDate       DateTime
  endDate         DateTime
  suppressesFlags Boolean      @default(true)
  createdAt       DateTime     @default(now())

  @@index([universityId, startDate, endDate])
  @@index([departmentId, startDate, endDate])
}

model FacilitiesIssue {
  id           String                  @id @default(cuid())
  universityId String
  university   University              @relation(fields: [universityId], references: [id], onDelete: Cascade)
  roomId       String
  room         Room                    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sessionId    String?
  session      LectureSession?         @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  reportedById String
  reportedBy   Profile                 @relation("FacilitiesReportedBy", fields: [reportedById], references: [id], onDelete: Cascade)
  category     SessionDisruptionReason
  description  String
  status       FacilitiesIssueStatus   @default(OPEN)
  createdAt    DateTime                @default(now())
  resolvedAt   DateTime?

  @@index([universityId, status, createdAt])
  @@index([roomId, status])
}
